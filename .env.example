APP_NAME="Portal Pembayaran Mahasiswa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Database MySQL — ganti kredensial sesuai server Anda.
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_pembayaran_mahasiswa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------------------------------------------------------------------
# Google OAuth (Laravel Socialite) — WAJIB diisi sebelum login dipakai.
# redirect = {APP_URL}/auth/google/callback
# Lihat README.md bagian "Konfigurasi Google Cloud OAuth".
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ---------------------------------------------------------------------
# Payment Gateway QRIS
# PAYMENT_GATEWAY=mock  -> provider pengembangan lokal (BUKAN pembayaran
#                          sungguhan). Ganti ke provider resmi di produksi.
# PAYMENT_GATEWAY_ENV   -> sandbox | production
# PAYMENT_GATEWAY_WEBHOOK_SECRET -> secret verifikasi HMAC webhook.
#                                   WAJIB diisi agar webhook diterima.
# ---------------------------------------------------------------------
PAYMENT_GATEWAY=mock
PAYMENT_GATEWAY_ENV=sandbox
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_SERVER_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_TIMEOUT=30

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
